+    @Test fun manualHotspotUsesIpv4WhileDirectPathStillUsesScopedIpv6() {
+        val ipv4 = ip("10.216.20.136")
+        val addresses = listOf(ip("fe80::1234"), ipv4)
+        assertEquals(ipv4, manualHotspotHostAddress(addresses, 7))
+        assertEquals(7, (wirelessHostAddress(addresses, 7) as Inet6Address).scopeId)
+    }
+
+    @Test fun manualHotspotFallsBackToScopedIpv6WhenNoUsableIpv4Exists() {
+        val addresses = listOf(ip("0.0.0.0"), ip("127.0.0.1"), ip("169.254.1.1"),
+            ip("224.0.0.251"), ip("fe80::1234"))
+        val result = manualHotspotHostAddress(addresses, 8) as Inet6Address
+        assertTrue(result.isLinkLocalAddress)
+        assertEquals(8, result.scopeId)
+        assertNull(manualHotspotHostAddress(addresses, 0))
+    }
