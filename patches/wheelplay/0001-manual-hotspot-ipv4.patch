+/** Local AP compatibility experiment; leave the Wi-Fi Direct selection unchanged. */
+internal fun manualHotspotHostAddress(addresses: List<InetAddress>, interfaceIndex: Int): InetAddress? =
+    addresses.firstOrNull {
