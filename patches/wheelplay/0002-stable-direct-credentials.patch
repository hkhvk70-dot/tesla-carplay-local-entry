+    private fun stableCredentials(): Credentials = synchronized(CREDENTIALS_LOCK) {
+        // Private app storage, with backup disabled in the mobile manifest. Neither field
+        // is emitted to diagnostics. A single commit prevents a half-written identity.
+        val savedSsid: String?
+        val savedPassphrase: String?
+        try {
+            savedSsid = ownership.getString("fixed_ssid", null)
+            savedPassphrase = ownership.getString("fixed_passphrase", null)
+        } catch (_: ClassCastException) {
+            throw IOException("Saved Wi-Fi Direct configuration has an invalid type")
+        }
+        if (savedSsid != null || savedPassphrase != null) {
+            if (savedSsid == null || !savedSsid.startsWith(ssidPrefix) ||
+                !savedSsid.removePrefix(ssidPrefix).matches(Regex("[A-Za-z0-9]{4}")) ||
+                savedPassphrase == null || savedPassphrase.length != 16 ||
+                savedPassphrase.any { it !in TOKEN_ALPHABET }) {
+                // Do not silently rotate an existing password and strand saved clients.
+                throw IOException("Saved Wi-Fi Direct configuration is invalid")
+            }
+            diagnostic("Wi-Fi P2P saved access reused=true")
+            return@synchronized Credentials(savedSsid, savedPassphrase)
+        }
+        val credentials = Credentials("$ssidPrefix${randomToken(4)}", randomToken(16))
+        if (!ownership.edit().putString("fixed_ssid", credentials.ssid)
+                .putString("fixed_passphrase", credentials.passphrase).commit()) {
+            throw IOException("Could not save Wi-Fi Direct configuration")
+        }
+        diagnostic("Wi-Fi P2P saved access reused=false")
+        credentials
+    }
 
