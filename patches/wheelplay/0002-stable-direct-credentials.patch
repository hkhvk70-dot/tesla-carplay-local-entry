+    @Test fun startupTimeoutDoesNotRotateSavedClientCredentialsOnRetry() {
+        radio.noCreateReply = true
+        WifiP2pGroupManager(context).use { manager ->
+            assertTrue(failure { manager.start(300) }.message!!.contains("group creation"))
+        }
+        val initialRequest = radio.requests.single()!!
+        radio.noCreateReply = false
+        WifiP2pGroupManager(context).use { manager ->
+            val recovered = background { manager.start(5000) }
+            assertEquals(initialRequest.networkName, recovered.ssid)
+            assertTrue("Recovery must preserve the saved password", initialRequest.passphrase == recovered.passphrase)
+        }
+    }
+
+    @Test fun incompleteSavedIdentityFailsWithoutCreatingOrRotatingAGroup() {
+        val saved = context.getSharedPreferences("carplay_wifi_p2p", Context.MODE_PRIVATE)
+        saved.edit().putString("fixed_ssid", "DIRECT-incomplete-test").commit()
+        WifiP2pGroupManager(context).use { manager ->
+            assertTrue(failure { manager.start(3000) }.message!!.contains("configuration is invalid"))
+        }
+        assertTrue(radio.requests.isEmpty())
+        assertEquals("DIRECT-incomplete-test", saved.getString("fixed_ssid", null))
+        assertFalse(saved.contains("fixed_passphrase"))
+    }
