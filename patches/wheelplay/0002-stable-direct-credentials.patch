+    @Test fun savedClientCredentialsSurviveGroupAndManagerRecreation() {
+        val first = WifiP2pGroupManager(context).use { manager -> background { manager.start(5000) } }
+        val logs = mutableListOf<String>()
+        val second = WifiP2pGroupManager(context, logs::add).use { manager -> background { manager.start(5000) } }
+        assertEquals(first.ssid, second.ssid)
+        assertTrue("Saved clients must keep the same password", first.passphrase == second.passphrase)
+        assertEquals(2, radio.removals)
+        assertTrue(logs.any { it.contains("saved access reused=true") })
+        assertFalse(logs.any { it.contains(first.ssid) || it.contains(first.passphrase) })
+        assertTrue(logs.all { DiagnosticRedactor.redact(it) != null })
+    }
